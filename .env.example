# Beispiel-Konfiguration – nur Variablennamen, keine Werte.
# Lokal: nach .env.local kopieren und ausfüllen. Auf Vercel: unter Project → Settings → Environment Variables.
# Niemals echte Werte committen.

# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Nur serverseitig (umgeht RLS). Niemals mit NEXT_PUBLIC_ versehen.
SUPABASE_SERVICE_ROLE_KEY=

# Feste öffentliche Adresse des Intranets für Links in E-Mails (Passwort-Reset),
# z. B. https://myicr.investmentclubregensburg.com – ohne abschließenden Schrägstrich.
NEXT_PUBLIC_SITE_URL=

# --- Cloudflare Turnstile (Registrierung) -----------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# "true", sobald in Supabase Auth → Attack Protection CAPTCHA (Turnstile, gleiches Secret)
# aktiviert ist: Dann prüft Supabase das Token und die App reicht es nur durch.
# Leer lassen, solange die CAPTCHA-Option in Supabase aus ist (sonst kein Bot-Schutz).
SUPABASE_AUTH_CAPTCHA=

# --- WhatsApp-Gruppe ----------------------------------------------------------
# Einladungslink (https://chat.whatsapp.com/…), nur serverseitig.
# Wird ausschließlich eingeloggten aktiven Mitgliedern angezeigt (inkl. QR-Code).
WHATSAPP_INVITE_URL=
