# Beispiel-Konfiguration – nur Variablennamen, keine Werte.
# Lokal: nach .env.local kopieren und ausfüllen. Auf Vercel: unter Project → Settings → Environment Variables.
# Niemals echte Werte committen.

# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Nur serverseitig (umgeht RLS). Niemals mit NEXT_PUBLIC_ versehen.
SUPABASE_SERVICE_ROLE_KEY=

# Feste öffentliche Adresse des Intranets für Links in E-Mails (Passwort-Reset),
# z. B. https://myicr.investmentclubregensburg.com – ohne abschließenden Schrägstrich.
NEXT_PUBLIC_SITE_URL=

# --- Cloudflare Turnstile (Registrierung) -----------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# "true", sobald in Supabase Auth → Attack Protection CAPTCHA (Turnstile, gleiches Secret)
# aktiviert ist: Dann prüft Supabase das Token und die App reicht es nur durch.
# Leer lassen, solange die CAPTCHA-Option in Supabase aus ist (sonst kein Bot-Schutz).
SUPABASE_AUTH_CAPTCHA=

# --- SEPA-Lastschrift (Gläubigerdaten des Vereins, nur serverseitig) ---------
# Werden nur für den SEPA-XML-Export geladen (nur Vorstand). Ohne gültige Werte
# ist der XML-Export gesperrt; der CSV-Export funktioniert weiter.
SEPA_CREDITOR_NAME=
SEPA_CREDITOR_IBAN=
SEPA_CREDITOR_BIC=
SEPA_CREDITOR_ID=

# --- WhatsApp-Gruppe ----------------------------------------------------------
# Einladungslink (https://chat.whatsapp.com/…), nur serverseitig.
# Wird ausschließlich eingeloggten aktiven Mitgliedern angezeigt (inkl. QR-Code).
WHATSAPP_INVITE_URL=

# --- Abfrage „Stimmen deine Daten noch?“ (nur serverseitig) --------------------
# "true" schaltet das Fenster ein: Jedes aktive Mitglied ohne Bestätigung seit dem letzten Stichtag
# (1.3./15.9.) wird beim nächsten Aufruf gefragt. Leer oder anderer Wert = aus.
DATA_CHECK_ENABLED=
# Datum des Einschaltens (YYYY-MM-DD). „Später“ geht bis 4 Wochen nach diesem Datum bzw. nach dem letzten
# Stichtag (das spätere zählt). Beim Einschalten IMMER mit setzen: Fehlt es oder ist es ungültig, zählt nur der
# Stichtag (dann evtl. für niemanden „Später“) und die App warnt einmal im Server-Log (supabase/README.md).
DATA_CHECK_START=
